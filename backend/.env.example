# Copy this file to backend/.env and replace placeholders.
# Never commit backend/.env.

ENVIRONMENT=development

# PostgreSQL is required. SQLite fallback is disabled.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eduverse_naac

# Required. Use a long random value in production (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480

# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
