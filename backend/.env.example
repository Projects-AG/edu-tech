# Copy this file to backend/.env and replace placeholders.
# Never commit backend/.env.

ENVIRONMENT=development

# PostgreSQL is required. SQLite fallback is disabled.
# Render/Supabase URLs beginning with postgres:// are normalized.
# For Supabase migrations prefer the direct/session connection (port 5432),
# not the transaction pooler.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eduverse_naac

# Required. Use a long random value in production (32+ characters).
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480

# Comma-separated browser origins. Do not use * in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase Storage (private bucket, S3-compatible).
# Project Settings -> Storage -> S3 access keys.
# Production startup fails if these are missing; uploads never silently
# fall back to local disk in production.
STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
STORAGE_BUCKET=naac-evidence
STORAGE_ACCESS_KEY=replace-with-supabase-s3-access-key
STORAGE_SECRET_KEY=replace-with-supabase-s3-secret-key
# If your S3 client requires an explicit region, set AWS_DEFAULT_REGION too.

# Frontend build-time variable (put this in frontend/.env, not backend/.env):
# VITE_API_BASE_URL=https://<backend-service>.onrender.com
