# Copy to frontend/.env.local for local development or set this variable in
# the frontend build environment (Render static site / Vercel).
#
# Use the backend origin only - do not append /api or a trailing slash.
# The API routes are mounted at the backend root (for example /auth/login,
# /accreditation-cycles, /documents/...).
VITE_API_BASE_URL=http://127.0.0.1:8001
